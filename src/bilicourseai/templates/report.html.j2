<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
      },
      svg: { fontCache: 'global' }
    };
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  <link rel="stylesheet" href="report.css">
</head>
<body>
  <header>
    <div class="header-inner">
      <h1>{{ report.title }}</h1>
      <div class="meta">
        <span>{{ report.bvid }}</span>
        {% if report.owner_name %}<span>UP: {{ report.owner_name }}</span>{% endif %}
        <a href="{{ report.source_url }}">{{ report.source_url }}</a>
      </div>
      <div class="global-action-status" data-global-action-status></div>
    </div>
  </header>
  <main>
    <nav>
      <div class="toc">
        {% macro render_toc_block(block, depth=0) %}
          {% if block.node_type != "raw" %}
            {% set visible_children = block.children|rejectattr("node_type", "equalto", "raw")|list %}
            {% set toc_action = block|toc_action_label %}
            {% set has_link_target = block|toc_has_link_target %}
            <li class="toc-node">
              <div class="toc-row">
                {% if visible_children %}
                  <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-children-{{ block.id }}" aria-label="展开 {{ block.title }}"></button>
                  {% if has_link_target %}
                    <a class="toc-node-link is-branch" href="#{{ block.id }}" data-toc-branch>{{ block.title }}</a>
                  {% else %}
                    <span class="toc-node-link toc-label is-branch" data-toc-branch>{{ block.title }}</span>
                  {% endif %}
                {% else %}
                  <span class="toc-spacer"></span>
                  {% if has_link_target %}
                    <a class="toc-node-link" href="#{{ block.id }}">{{ block.title }}</a>
                  {% else %}
                    <span class="toc-node-link toc-label">{{ block.title }}</span>
                  {% endif %}
                {% endif %}
                {% if toc_action %}
                  <button class="toc-action node-action" type="button" data-action="{{ 'redo' if block.status == 'expanded' else 'expand' }}" data-report="report.json" data-block-id="{{ block.id }}">{{ toc_action }}</button>
                  <span class="toc-action-status node-action-status" aria-live="polite"></span>
                {% else %}
                  <span></span>
                {% endif %}
              </div>
              {% if visible_children %}
                <ul class="toc-children" id="toc-children-{{ block.id }}" hidden>
                  {% for child in visible_children %}
                    {{ render_toc_block(child, depth + 1) }}
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endif %}
        {% endmacro %}
        {% for part in report.parts %}
          {% if part.blocks %}
            {% set part_title = part.title if part.page == 0 else ("P" ~ part.page ~ " " ~ part.title) %}
            {% set visible_roots = part.blocks|rejectattr("node_type", "equalto", "raw")|list %}
            {% if part.page == 0 and part.title == "分 P 目录" %}
              {% for block in visible_roots %}
                <div class="toc-part">
                  <ul class="toc-tree">
                    {{ render_toc_block(block) }}
                  </ul>
                </div>
              {% endfor %}
            {% else %}
              <div class="toc-part">
              {% set single_leaf_part = visible_roots|length == 1 and visible_roots[0].node_type == "leaf" and not (visible_roots[0].children|rejectattr("node_type", "equalto", "raw")|list) %}
              {% set single_part_wrapper = part.page > 0 and visible_roots|length == 1 and visible_roots[0].id == ("part-p" ~ part.page) and (visible_roots[0].children|rejectattr("node_type", "equalto", "raw")|list) %}
              {% set toc_roots = (visible_roots[0].children|rejectattr("node_type", "equalto", "raw")|list) if single_part_wrapper else visible_roots %}
              {% if single_leaf_part %}
                <div class="toc-row">
                  <span class="toc-spacer"></span>
                  {% set toc_action = visible_roots[0]|toc_action_label %}
                  {% set has_link_target = visible_roots[0]|toc_has_link_target %}
                  {% if has_link_target %}
                    <a class="toc-node-link" href="#{{ visible_roots[0].id }}">{{ part_title }}</a>
                  {% else %}
                    <span class="toc-node-link toc-label">{{ part_title }}</span>
                  {% endif %}
                  {% if toc_action %}
                    <button class="toc-action node-action" type="button" data-action="{{ 'redo' if visible_roots[0].status == 'expanded' else 'expand' }}" data-report="report.json" data-block-id="{{ visible_roots[0].id }}">{{ toc_action }}</button>
                    <span class="toc-action-status node-action-status" aria-live="polite"></span>
                  {% else %}
                    <span></span>
                  {% endif %}
                </div>
              {% else %}
                <div class="toc-row">
                  <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-part-children-{{ part.page }}" aria-label="展开 {{ part_title }}"></button>
                  <a class="toc-node-link is-branch" href="#part-{{ part.page }}" data-toc-branch>{{ part_title }}</a>
                  <span></span>
                </div>
                <ul class="toc-tree toc-children" id="toc-part-children-{{ part.page }}" hidden>
                  {% for block in toc_roots %}
                    {{ render_toc_block(block) }}
                  {% endfor %}
                </ul>
              {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </nav>
    <section>
      {% if not (report|report_has_body_content) %}
        <article class="empty-reading">
          <h2>还没有可阅读的知识笔记</h2>
          <p>请在左侧目录选择一个节点，点击“展开划分”。当展开到真正的知识节点后，这里会显示对应笔记和辅助理解图。</p>
        </article>
      {% endif %}
      {% for part in report.parts %}
        {% if part.blocks and part is has_body_content %}
        <article class="part" id="part-{{ part.page }}">
          {% if not (part.page == 0 and part.title == "分 P 目录") %}
            <h2>{{ part.title if part.page == 0 else ("P" ~ part.page ~ " " ~ part.title) }}</h2>
          {% endif %}
          {% if part.selected_subtitle_track %}
            <div class="meta">
              <span>字幕: {{ part.selected_subtitle_track.lan_doc or part.selected_subtitle_track.lan }}</span>
              <span>{{ "AI" if part.selected_subtitle_track.is_ai else "人工/未知" }}</span>
            </div>
          {% endif %}
          {% if part is not has_transcript %}
            <div class="empty">没有抓取到字幕。后续可接入 cookies、ASR 或本地视频音频提取。</div>
          {% endif %}
          {% macro render_block(block, part, ancestors="") %}
            {% if block.node_type != "raw" %}
              {% set display_part_page = block.source_part_page or part.page %}
              {% set visible_children = block.children|rejectattr("node_type", "equalto", "raw")|list %}
              {% set has_note_content = block.key_points or block.sections or block.frames or block.visual_requests or block.visual_analyses %}
              {% set body_action = block|body_action_label %}
              {% set structure_only = (block|toc_action_label) and not has_note_content %}
              {% set part_prefix = ("P" ~ display_part_page) if display_part_page > 0 and report.parts|length > 1 else "" %}
              {% set display_title = (part_prefix ~ " " ~ block.title) if part_prefix and not block.title.startswith(part_prefix ~ " ") else block.title %}
              {% if structure_only %}
                <div id="{{ block.id }}" class="branch-anchor"></div>
                {% if visible_children %}
                  {% set child_ancestors = ancestors ~ " / " ~ display_title if ancestors else display_title %}
                  {% for child in visible_children %}
                    {{ render_block(child, part, child_ancestors) }}
                  {% endfor %}
                {% endif %}
              {% else %}
              <details id="{{ block.id }}" open>
                {% if ancestors %}
                  <div class="node-breadcrumb">{{ ancestors }}</div>
                {% endif %}
                <summary>
                  <span class="time">
                    <a href="{{ report.source_url|bilibili_time_url(display_part_page, block.start) }}" target="_blank" rel="noopener">
                      {{ block.start|time_label }} - {{ block.end|time_label }}
                    </a>
                  </span>
                  <span class="block-title">
                    {{ display_title }}
                  </span>
                </summary>
                {% if block.summary and not block.sections %}
                  <div class="summary">{{ block.summary|note_html }}</div>
                {% endif %}
                {% if body_action %}
                  <div class="node-actions" data-block-actions="{{ block.id }}">
                    <button class="node-action {{ 'secondary' if block.status == 'expanded' else '' }}" type="button" data-action="{{ 'redo' if block.status == 'expanded' else 'expand' }}" data-report="report.json" data-block-id="{{ block.id }}">{{ body_action }}</button>
                    <span class="node-action-status" aria-live="polite"></span>
                  </div>
                {% endif %}
                {% if block.key_points %}
                  <ul class="key-points">
                    {% for point in block.key_points %}
                      <li>{{ point|md_inline }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
                {% if block.sections %}
                  <div class="note-sections">
                    {% for section in block.sections %}
                      <section class="note-section">
                        <h3>{{ section.title }}</h3>
                        <div class="note-section-body">{{ section.body|md_html }}</div>
                        {% for frame in section.frames %}
                          <div class="visual">
                            {% if frame.error %}
                              <div class="empty">截图失败：{{ frame.error }}</div>
                            {% else %}
                              <button class="image-button" type="button" data-lightbox-src="{{ frame.path|relative_asset(report_dir) }}" data-lightbox-alt="P{{ frame.part_page }} {{ frame.timestamp|time_label }}">
                                <img src="{{ frame.path|relative_asset(report_dir) }}" alt="P{{ frame.part_page }} {{ frame.timestamp|time_label }}">
                              </button>
                            {% endif %}
                            <div>
                              <h3>
                                <a href="{{ report.source_url|bilibili_time_url(frame.part_page, frame.timestamp) }}" target="_blank" rel="noopener">
                                  辅助理解图 · {{ frame.timestamp|time_label }}
                                </a>
                              </h3>
                              {% for request in section.visual_requests %}
                                {% if request.id == frame.request_id %}
                                  <div class="visual-note-body">{{ request.reason|md_html }}</div>
                                {% endif %}
                              {% endfor %}
                              {% for analysis in section.visual_analyses %}
                                {% if analysis.request_id == frame.request_id %}
                                  <div class="visual-note">
                                    {% if analysis.summary %}
                                      <div class="visual-note-item">
                                        <span class="visual-note-label">看什么</span>
                                        <div class="visual-note-body">{{ analysis.summary|visual_note_text|md_inline }}</div>
                                      </div>
                                    {% endif %}
                                    {% if analysis.learning_value %}
                                      <div class="visual-note-item">
                                        <span class="visual-note-label">为什么</span>
                                        <div class="visual-note-body">{{ analysis.learning_value|visual_note_text|md_inline }}</div>
                                      </div>
                                    {% endif %}
                                    {% if analysis.guidance %}
                                      <div class="visual-note-item">
                                        <span class="visual-note-label">怎么用</span>
                                        <div class="visual-note-body">{{ analysis.guidance|visual_note_text|md_inline }}</div>
                                      </div>
                                    {% endif %}
                                  </div>
                                {% endif %}
                              {% endfor %}
                            </div>
                          </div>
                        {% endfor %}
                      </section>
                    {% endfor %}
                  </div>
                {% endif %}
                {% for frame in block.frames %}
                  {% set frame_request = (block.visual_requests|selectattr("id", "equalto", frame.request_id)|list|first) %}
                  {% if not frame_request or not frame_request.section_id %}
                    <div class="visual">
                      {% if frame.error %}
                        <div class="empty">截图失败：{{ frame.error }}</div>
                      {% else %}
                        <button class="image-button" type="button" data-lightbox-src="{{ frame.path|relative_asset(report_dir) }}" data-lightbox-alt="P{{ frame.part_page }} {{ frame.timestamp|time_label }}">
                          <img src="{{ frame.path|relative_asset(report_dir) }}" alt="P{{ frame.part_page }} {{ frame.timestamp|time_label }}">
                        </button>
                      {% endif %}
                  <div>
                      <h3>
                        <a href="{{ report.source_url|bilibili_time_url(frame.part_page, frame.timestamp) }}" target="_blank" rel="noopener">
                          辅助理解图 · {{ frame.timestamp|time_label }}
                        </a>
                      </h3>
                      {% for request in block.visual_requests %}
                        {% if request.id == frame.request_id %}
                          <div class="visual-note-body">{{ request.reason|md_html }}</div>
                        {% endif %}
                      {% endfor %}
                      {% for analysis in block.visual_analyses %}
                        {% if analysis.request_id == frame.request_id %}
                          <div class="visual-note">
                            {% if analysis.summary %}
                              <div class="visual-note-item">
                                <span class="visual-note-label">看什么</span>
                                <div class="visual-note-body">{{ analysis.summary|visual_note_text|md_inline }}</div>
                              </div>
                            {% endif %}
                            {% if analysis.learning_value %}
                              <div class="visual-note-item">
                                <span class="visual-note-label">为什么</span>
                                <div class="visual-note-body">{{ analysis.learning_value|visual_note_text|md_inline }}</div>
                              </div>
                            {% endif %}
                            {% if analysis.guidance %}
                              <div class="visual-note-item">
                                <span class="visual-note-label">怎么用</span>
                                <div class="visual-note-body">{{ analysis.guidance|visual_note_text|md_inline }}</div>
                              </div>
                            {% endif %}
                            {% if analysis.observed_elements %}
                              <div class="visual-note-item">
                                <span class="visual-note-label">图中元素</span>
                                <div class="visual-note-body">
                                  <ul>
                                    {% for item in analysis.observed_elements[:4] %}
                                      <li>{{ item|md_inline }}</li>
                                    {% endfor %}
                                  </ul>
                                </div>
                              </div>
                            {% endif %}
                            {% if analysis.pitfalls %}
                              <div class="visual-note-item">
                                <span class="visual-note-label">易错点</span>
                                <div class="visual-note-body">
                                  <ul>
                                    {% for item in analysis.pitfalls[:3] %}
                                      <li>{{ item|md_inline }}</li>
                                    {% endfor %}
                                  </ul>
                                </div>
                              </div>
                            {% endif %}
                          </div>
                        {% endif %}
                    {% endfor %}
                  </div>
                </div>
                  {% endif %}
              {% endfor %}
                {% for child in block.children %}
                  {% if child.node_type == "raw" %}
                    <details class="transcript-toggle">
                      <summary>原始字幕</summary>
                      <div class="transcript">
                        {% for sentence in child.transcript|sentences %}
                          <p>{{ sentence }}</p>
                        {% endfor %}
                      </div>
                    </details>
                  {% endif %}
                {% endfor %}
                {% if visible_children %}
                  <div class="child-blocks">
                    {% set child_ancestors = ancestors ~ " / " ~ display_title if ancestors else display_title %}
                    {% for child in visible_children %}
                      {{ render_block(child, part, child_ancestors) }}
                    {% endfor %}
                  </div>
                {% endif %}
              </details>
              {% endif %}
            {% endif %}
          {% endmacro %}
          {% set visible_roots = part.blocks|rejectattr("node_type", "equalto", "raw")|list %}
          {% set single_part_wrapper = part.page > 0 and visible_roots|length == 1 and visible_roots[0].id == ("part-p" ~ part.page) and (visible_roots[0].children|rejectattr("node_type", "equalto", "raw")|list) %}
          {% set body_roots = (visible_roots[0].children|rejectattr("node_type", "equalto", "raw")|list) if single_part_wrapper else visible_roots %}
          {% for block in body_roots %}
              {{ render_block(block, part) }}
          {% endfor %}
        </article>
        {% endif %}
      {% endfor %}
    </section>
  </main>
  <div class="lightbox" id="image-lightbox" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="关闭">×</button>
    <img id="lightbox-image" alt="">
  </div>
  <script src="report.js"></script>
</body>
</html>
